        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Write valid JSON with a business conflict in record 2" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def key = vars.get(&apos;key&apos;) + &apos;-rollback&apos;
vars.put(&apos;rollbackKey&apos;, key)
def venue = [name: key + &apos;-venue&apos;, capacity: 100, type: &apos;THEATRE&apos;]
def event = [name: key + &apos;-event&apos;, date: &apos;2030-11-15T19:00:00&apos;,
             minAge: 18, ticketsCount: 100, description: &apos;Must roll back&apos;]
def person = [hairColor: &apos;BROWN&apos;, height: 181, nationality: &apos;FRANCE&apos;,
              location: [x: 2.5, y: 3, z: 4, name: key + &apos;-person&apos;]]
def tickets = (1..2).collect { index -&gt;
    [name: key + &apos;-ticket-&apos; + index, coordinates: [x: 10, y: 20], price: 1000,
     type: &apos;USUAL&apos;, discount: 5, number: 1, venue: venue, event: event, person: person]
}
def file = new File(props.getProperty(&apos;jm.directory&apos;), key + &apos;.json&apos;)
file.setText(groovy.json.JsonOutput.toJson([tickets: tickets]), &apos;UTF-8&apos;)
vars.put(&apos;importFile&apos;, file.absolutePath)
SampleResult.setIgnore()</stringProp>
