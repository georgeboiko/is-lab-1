          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def directory = props.getProperty(&apos;jm.directory&apos;)
if (directory) {
    new File(directory).eachFile { file -&gt; assert file.delete() : &apos;Could not remove &apos; + file }
    assert new File(directory).delete()
}
