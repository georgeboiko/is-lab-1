          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Cross-user assertion: final ticket equals one complete successful update" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def data = prev.getResponseDataAsString().trim() ?
    new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()) : null
def responses = (0..&lt;ctx.getThreadGroup().getNumThreads()).collect {
    props.get(vars.get(&apos;key&apos;) + &apos;|&apos; + it)
}
assert responses.every { it != null } : &apos;Some concurrent requests have not completed&apos;
def outcomes = responses.collect {
    [code: it.code, body: it.json.trim().startsWith(&apos;{&apos;) ?
        new groovy.json.JsonSlurper().parseText(it.json) : null]
}

        def successful = outcomes.findAll { it.code == &apos;200&apos; }
        assert !successful.isEmpty() : &apos;No update succeeded&apos;
        assert successful.any { outcome -&gt;
            def body = outcome.body
            data.name == body.name &amp;&amp; data.price == body.price &amp;&amp; data.coordinates == body.coordinates &amp;&amp;
            data.number == body.number &amp;&amp; data.discount == body.discount &amp;&amp; data.type == body.type &amp;&amp;
            data.venue.id == body.venue.id &amp;&amp; data.event.id == body.event.id &amp;&amp; data.person.id == body.person.id
        } : &apos;Final state is not a complete result of any successful update: &apos; +
            groovy.json.JsonOutput.toJson([actual: data, successful: successful])</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>
