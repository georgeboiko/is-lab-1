          <stringProp name="script">vars.put(&apos;number&apos;, (700000 + vars.get(&apos;round&apos;).toInteger() * 10).toString())
   def ticket = [name: vars.get(&apos;key&apos;) + &apos;-u&apos; + ctx.getThreadNum(),
coordinates: [x: 10, y: 20], personId: vars.get(&apos;fixturePerson&apos;).toLong(),
eventId: vars.get(&apos;fixtureEvent&apos;).toLong(), venueId: vars.get(&apos;fixtureVenue&apos;).toLong(),
price: 1000, type: &apos;USUAL&apos;, discount: 5, number: vars.get(&apos;number&apos;).toInteger()]
   vars.put(&apos;raceBody&apos;, groovy.json.JsonOutput.toJson(ticket))
   def venue = [name: props.getProperty(&apos;jm.run&apos;) + &apos;-fixture-venue&apos;, capacity: 500, type: &apos;THEATRE&apos;]
   def event = [name: props.getProperty(&apos;jm.run&apos;) + &apos;-fixture-event&apos;, date: &apos;2030-11-15T19:00:00&apos;,
                minAge: 18, ticketsCount: 500, description: &apos;JMeter fixture&apos;]
   def tickets = (0..1).collect { index -&gt;
       [name: vars.get(&apos;key&apos;) + &apos;-import-&apos; + index, coordinates: [x: 10, y: 20],
        price: 1000, type: &apos;USUAL&apos;, discount: 5,
        number: vars.get(&apos;number&apos;).toInteger() + index, venue: venue, event: event]
   }
   def file = new File(props.getProperty(&apos;jm.directory&apos;), vars.get(&apos;key&apos;) + &apos;-cross-&apos; + ctx.getThreadNum() + &apos;.json&apos;)
   file.setText(groovy.json.JsonOutput.toJson([tickets: tickets]), &apos;UTF-8&apos;)
   vars.put(&apos;importFile&apos;, file.absolutePath)
SampleResult.setIgnore()</stringProp>
        </JSR223Sampler>
