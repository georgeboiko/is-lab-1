      </ConfigTestElement>
      <hashTree/>
      <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Share responses of RACE requests between users" enabled="true">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">if (prev.getSampleLabel().startsWith(&apos;RACE &apos;)) {
    props.put(vars.get(&apos;key&apos;) + &apos;|&apos; + ctx.getThreadNum(),
              [code: prev.getResponseCode(), json: prev.getResponseDataAsString()])
}</stringProp>
      </JSR223PostProcessor>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="00 - Register different users and prepare fixtures" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Iterations">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Initialize this run" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">assert vars.get(&apos;users&apos;).toInteger() in 2..100
assert vars.get(&apos;race_users&apos;).toInteger() in 2..100
assert vars.get(&apos;iterations&apos;).toInteger() in 1..100
assert vars.get(&apos;race_iterations&apos;).toInteger() in 1..1000
assert vars.get(&apos;max_retries&apos;).toInteger() in 1..100
def run = &apos;jm_&apos; + UUID.randomUUID().toString().replace(&apos;-&apos;, &apos;&apos;).take(12)
props.setProperty(&apos;jm.run&apos;, run)
props.setProperty(&apos;jm.runUpper&apos;, run.toUpperCase(Locale.ROOT))
props.setProperty(&apos;jm.ready&apos;, &apos;false&apos;)
props.setProperty(&apos;jm.directory&apos;, java.nio.file.Files.createTempDirectory(&apos;lab1-jmeter-&apos;).toString())
vars.put(&apos;accountCount&apos;, Math.max(vars.get(&apos;users&apos;).toInteger(), vars.get(&apos;race_users&apos;).toInteger()).toString())
props.setProperty(&apos;jm.accounts&apos;, vars.get(&apos;accountCount&apos;))
vars.put(&apos;accountIndex&apos;, &apos;-1&apos;)
log.info(&apos;LR2 JMeter run prefix: &apos; + run)
SampleResult.setIgnore()</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Register one account per virtual user" enabled="true">
