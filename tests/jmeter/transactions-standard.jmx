          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Cross-user assertion: only the ordinary create or the whole import committed" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def data = prev.getResponseDataAsString().trim() ?
    new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()) : null
def responses = (0..&lt;ctx.getThreadGroup().getNumThreads()).collect {
    props.get(vars.get(&apos;key&apos;) + &apos;|&apos; + it)
}
assert responses.every { it != null } : &apos;Some concurrent requests have not completed&apos;
def outcomes = responses.collect {
    [code: it.code, body: it.json.trim().startsWith(&apos;{&apos;) ?
        new groovy.json.JsonSlurper().parseText(it.json) : null]
}

        def create = outcomes[0]
        def imported = outcomes[1]
        def first = vars.get(&apos;number&apos;).toInteger()
        if (create.code == &apos;201&apos;) {
            assert imported.code == &apos;409&apos; : &apos;Both competing transactions committed&apos;
            assert data.size() == 1 &amp;&amp; data[0].number == first
            assert data[0].name == vars.get(&apos;key&apos;) + &apos;-u0&apos;
        } else {
            assert create.code == &apos;409&apos; &amp;&amp; imported.code == &apos;200&apos;
            assert data.size() == 2
            assert data.collect { it.number }.sort() == [first, first + 1]
            assert data.every { it.name.startsWith(vars.get(&apos;key&apos;) + &apos;-import-&apos;) }
        }
        assert data.every { it.venue.id.toString() == vars.get(&apos;fixtureVenue&apos;) &amp;&amp;
                            it.event.id.toString() == vars.get(&apos;fixtureEvent&apos;) }</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>
