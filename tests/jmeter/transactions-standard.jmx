        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Write input that violates the coordinates constraint" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def file = new File(vars.get(&apos;importFile&apos;))
def document = new groovy.json.JsonSlurper().parse(file, &apos;UTF-8&apos;)
document.tickets = [document.tickets[0]]
document.tickets[0].coordinates.x = 223
file.setText(groovy.json.JsonOutput.toJson(document), &apos;UTF-8&apos;)
SampleResult.setIgnore()</stringProp>
        </JSR223Sampler>
