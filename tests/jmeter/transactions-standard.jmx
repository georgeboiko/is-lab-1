        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Write competing JSON files" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def venue = [name: props.getProperty(&apos;jm.run&apos;) + &apos;-fixture-venue&apos;, capacity: 500, type: &apos;THEATRE&apos;]
def event = [name: props.getProperty(&apos;jm.run&apos;) + &apos;-fixture-event&apos;, date: &apos;2030-11-15T19:00:00&apos;,
             minAge: 18, ticketsCount: 500, description: &apos;JMeter fixture&apos;]
def tickets = (1..2).collect { index -&gt;
    [name: vars.get(&apos;key&apos;) + &apos;-u&apos; + ctx.getThreadNum() + &apos;-&apos; + index,
     coordinates: [x: 10, y: 20], price: 1000, type: &apos;USUAL&apos;, discount: 5,
     number: 600000 + vars.get(&apos;round&apos;).toInteger() * 10 + index, venue: venue, event: event]
}
def file = new File(props.getProperty(&apos;jm.directory&apos;), vars.get(&apos;key&apos;) + &apos;-u&apos; + ctx.getThreadNum() + &apos;.json&apos;)
file.setText(groovy.json.JsonOutput.toJson([tickets: tickets]), &apos;UTF-8&apos;)
vars.put(&apos;importFile&apos;, file.absolutePath)
SampleResult.setIgnore()</stringProp>
        </JSR223Sampler>
